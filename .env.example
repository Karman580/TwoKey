# Copy with `python scripts/gen_keys.py` (fills the three secrets below).
# Never commit .env. Values here are placeholders, not working keys.

# Ed25519 keys per organisation: "Org=base64,Org=base64,..."
TWOKEY_SECRET_KEYS=
TWOKEY_PUBKEYS=
# Salt for hashing VPAs before they go on the shared ledger (16+ chars)
VPA_HASH_SALT=

# Dev ledger (stand-in for the Drunix network)
LEDGER_URL=http://127.0.0.1:8081
DEVLEDGER_ADDR=127.0.0.1:8081
DEVLEDGER_DATA=.data/ledger.jsonl
# 1 enables the "fast-forward clock" demo control. Never enable outside a demo.
DEVLEDGER_ALLOW_CLOCK=1

# Services
APP_HOST=127.0.0.1
APP_PORT=8000
HOLD_MEDIUM_SECONDS=1800
HOLD_HIGH_SECONDS=14400
VALUE_FLOOR_PAISE=1000000
KEEPER_INTERVAL_SECONDS=5
